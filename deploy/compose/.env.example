# my-market compose 环境变量模板（R0 infra + ai profile）。
# 用法：cp deploy/compose/.env.example deploy/compose/.env，然后逐项填写。
# docker compose -f deploy/compose/docker-compose.yml 会自动加载同目录 .env。
# .env 已被 .gitignore 忽略，勿提交真实值；本模板不含任何真实密钥。

# ===== 必填：控制面共享令牌 =====
# billing / router / gateway / agent 启动时读取 CONTROL_PLANE_TOKEN，未设置会直接退出
# （请求头 X-Control-Token / gRPC metadata x-control-token，服务间互信的唯一凭证）。
# 生成：openssl rand -hex 32
CONTROL_PLANE_TOKEN=

# ===== MySQL =====
# root 密码（本地默认 root 即可）；billing/router/agent 的容器内 DSN 会同步带上该值。
MYSQL_ROOT_PASSWORD=root

# ===== gateway 管理面板（:18080）=====
# 管理面板登录令牌（X-Admin-Token 请求头）；留空时面板回退 admin-demo（见 gateway 启动日志）。
# 生成：openssl rand -hex 16
ADMIN_TOKEN=
# gateway → agent 的管理面板 AI 客服共享密钥；留空则管理面板 AI 客服不可用。
# 生成：openssl rand -hex 16
AGENT_INTERNAL_TOKEN=
# 管理员未指定租户时的默认作用域（租户 id；demo 种子数据 1 = moon）
ADMIN_DEFAULT_TENANT=1
# 每分钟限流阈值（压测脚本会自动提到 100000）
RATE_LIMIT_PER_MIN=600

# ===== agent AI 客服（:9105）=====
# DeepSeek API 密钥（https://platform.deepseek.com 申请，形如 sk-xxxx）。
# 允许留空启动：agent 正常起、/healthz 正常，仅每次对话返回明确错误提示。
AGENT_LLM_API_KEY=
# 上游端点与模型有官方默认值，一般不用填
# AGENT_LLM_BASE_URL=https://api.deepseek.com
# AGENT_LLM_MODEL=deepseek-flash

# ===== mock-provider（:9201）=====
# 注意：schema.sql 种子数据把 provider 地址写成宿主回环 http://127.0.0.1:9201/9202，
# 容器内 router 够不到 127.0.0.1——R0-T4 smoke 需用 admin API 或 SQL 把 provider
# 重指到 compose 服务名（http://mock-provider:9201）后完整对话链路才通。
MOCK_PROVIDER_PORT=9201
MOCK_PROVIDER_NAME=mock-provider
# 故障/延迟注入（默认关闭）：MOCK_FAIL_RATE 取 0-100 百分比，MOCK_LATENCY_MS 毫秒
MOCK_FAIL_RATE=0
MOCK_LATENCY_MS=0

# ===== billing 计费事件流 =====
# 容器内恒连 kafka:9092（compose 用 ${KAFKA_BROKERS:-kafka:9092}，留空也连，不会禁用 relay）；
# 仅宿主本地进程跑 billing 时才需要置 127.0.0.1:29092。
# KAFKA_BROKERS=kafka:9092
# 订阅自动续费扫描间隔（秒）
SUB_RENEW_INTERVAL_SEC=60

# ===== 其他 =====
LOG_LEVEL=info
# REDIS_PASSWORD=   （本地 redis 未设密码，留空即可）
