# 环境变量与密钥（example 模板保留入库）
.env*
!*.env.example
!*.example

# 本流程工作区
.superpowers/

# 运行期日志
logs/
*.log

# 系统文件
.DS_Store

# 依赖与构建缓存
node_modules/

# 本地 compose 覆盖配置
deploy/compose/.env

# 构建产物（勿入库）
/mall-bff
/mall-goods
/mall-order
/seckill

# 评测资产运行产物（R2.6-T2 起 eval 资产在顶层 eval/ai-gateway/，数据集入库、可再生产物忽略）
# Companion raw JSON remains local; byte-identical gzip and SHA manifests are tracked.
eval/ai-gateway/behavior-review/v*/*.behavior.json
# 评测报告（由 services/ai-gateway cmd/eval 等工具重新生成）
eval/ai-gateway/reports/
__pycache__/
# 2026-11 线下压测原始运行数据（结论在 docs，原始目录只留本地）
/eval/ai-gateway/project-load-2026-11-02/
